PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:123456@localhost:5432/coreslash?schema=public

JWT_SECRET=coreslash_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=coreslash_jwt_refresh_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

API_PREFIX=api
API_VERSION=v1

APP_NAME=CoreSlash Technologies API
APP_URL=http://localhost:5000

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

UPLOAD_DESTINATION=storage/uploads
MAX_FILE_SIZE=10485760

LOG_LEVEL=debug