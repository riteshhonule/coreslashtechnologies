PORT=5000

NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/coreslash_db?schema=public

JWT_SECRET=coreslash_jwt_secret_key_change_in_production

JWT_REFRESH_SECRET=coreslash_jwt_refresh_secret_key_change_in_production

JWT_EXPIRES_IN=15m

JWT_REFRESH_EXPIRES_IN=7d

API_PREFIX=api

API_VERSION=v1

APP_NAME=CoreSlash Technologies API

APP_URL=http://localhost:5000

FRONTEND_URL=http://localhost:5173

CORS_ORIGIN=http://localhost:5173

UPLOAD_DESTINATION=storage/uploads

MAX_FILE_SIZE=10485760

LOG_LEVEL=debug

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=coreslash:
REDIS_CONNECT_TIMEOUT=10000
REDIS_MAX_RETRIES=3
REDIS_URL=

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CoreSlash Technologies <noreply@coreslash.com>"
SMTP_SECURE=false
